{
  "name": "project-base",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=6044 ./node_modules/@angular/cli/bin/ng serve",
    "start:avison": "ng serve --configuration avison",
    "start:saas": "ng serve --configuration saas",
    "build": "ng build --configuration production --base-href /",
    "build:prod": "ng build --configuration production --base-href=/scale/",
    "build:dev": "ng build --configuration development --base-href=/scale/",
    "watch": "ng build --watch --configuration production",
    "test": "ng test",
    "electron": "electron .",
    "electron:build:angular": "ng build --configuration production --base-href=./",
    "electron:fix:basehref": "powershell -Command \"if (Test-Path 'dist/scale/index.html') { (Get-Content 'dist/scale/index.html') -replace 'base href=\\\"/\\\"', 'base href=\\\"./\\\"' | Set-Content 'dist/scale/index.html' }\"",
    "electron:inject:api": "node scripts/inject-api-endpoint-electron.js",
    "electron:dev": "npm run electron:fix:basehref && electron .",
    "electron:build": "npm run electron:fix:basehref && npx electron-builder",
    "electron:build:win": "npm run electron:fix:basehref && npx electron-builder --win",
    "electron:build:win:portable": "npm run electron:fix:basehref && npx electron-builder --win portable",
    "electron:build:win:nsis": "npm run electron:build:angular && npm run electron:fix:basehref && npx electron-builder --win nsis"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^16.2.14",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/localize": "^18.2.13",
    "@angular/material": "^16.2.14",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@ant-design/icons-angular": "^19.0.0",
    "@date-fns/tz": "^1.2.0",
    "@fullcalendar/angular": "^6.1.15",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@types/sockjs-client": "^1.5.4",
    "@worktile/gantt": "^19.0.2",
    "angular-split": "^19.0.0",
    "echarts": "^5.5.1",
    "exceljs": "^4.3.0",
    "file-saver": "^2.0.5",
    "force": "^0.0.3",
    "jwt-decode": "^3.1.2",
    "keycloak-angular": "^13.1.0",
    "keycloak-js": "^21.1.2",
    "moment": "^2.30.1",
    "ng-zorro-antd": "^15.1.0",
    "ngx-bootstrap": "^10.2.0",
    "ngx-cookie-service": "^15.0.0",
    "ngx-device-detector": "^8.0.0",
    "ngx-echarts": "^15.0.3",
    "ngx-mask": "^14.2.4",
    "ngx-number-format": "^14.0.0",
    "ngx-toastr": "^16.2.0",
    "ngx-translate": "^0.0.1-security",
    "ngx-ui-loader": "^13.0.0",
    "ngx-ui-tour-md-menu": "^10.7.0",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "sweetalert2": "^11.7.12",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "~18.2.19",
    "@angular/compiler-cli": "^18.2.13",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~4.3.0",
    "@types/moment": "^2.13.0",
    "autoprefixer": "^10.4.22",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.4.5"
  },
  "build": {
    "appId": "com.scale.management",
    "productName": "Scale Management System",
    "electronVersion": "40.0.0",
    "directories": {
      "output": "dist-electron-1.0.0",
      "buildResources": "build"
    },
    "npmRebuild": false,
    "files": [
      "dist/scale/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "dist/scale",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scale Management System",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
